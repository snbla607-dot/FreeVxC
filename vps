
#!/usr/bin/env bash
set -euo pipefail

HOSTNAME_SET="billubadmosh"
IMAGE="billubadmosh-vps"
LABEL="billubadmosh-vps"
BUILD_DIR="/tmp/billubadmosh-vps"

show_banner() {
    clear
    printf "\e[38;5;196m==============================\e[0m\n"
    printf "\e[38;5;226m   BILLUBADMOSH VPS MANAGER   \e[0m\n"
    printf "\e[38;5;46m==============================\e[0m\n"
    echo "👍 Like  ⭐ Subscribe  🚀 Share"
    echo
}

pause() {
    read -r -p "Press Enter..." _
}

select_container() {
    mapfile -t CONTAINERS < <(
        docker ps -a \
            --filter "label=${LABEL}=true" \
            --format "{{.Names}}"
    )

    if [ "${#CONTAINERS[@]}" -eq 0 ]; then
        echo "No BilluBadmosh VPS containers found."
        return 1
    fi

    for i in "${!CONTAINERS[@]}"; do
        echo "$((i + 1))) ${CONTAINERS[$i]}"
    done

    read -r -p "Select: " idx

    if [[ ! "$idx" =~ ^[0-9]+$ ]] ||
       (( idx < 1 || idx > ${#CONTAINERS[@]} )); then
        echo "Invalid selection."
        return 1
    fi

    SEL="${CONTAINERS[$((idx - 1))]}"
}

build_image() {
    local base_image="$1"
    local image_tag

    image_tag="${IMAGE}:${base_image//[:\/]/-}"

    mkdir -p "$BUILD_DIR"
    cd "$BUILD_DIR"

    cat > Dockerfile <<EOF
FROM ${base_image}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl wget nano sudo bash git unzip zip tar vim \
    htop screen tmux net-tools iproute2 procps python3 python3-pip \
    nodejs npm \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /root
CMD ["bash"]
EOF

    if ! docker image inspect "$image_tag" >/dev/null 2>&1; then
        echo "Building BilluBadmosh image: $image_tag"
        docker build -t "$image_tag" .
    fi

    BUILT_IMAGE="$image_tag"
}

if ! command -v docker >/dev/null 2>&1; then
    echo "Error: Docker is not installed."
    exit 1
fi

if ! docker info >/dev/null 2>&1; then
    echo "Error: Docker daemon is unavailable or permission was denied."
    exit 1
fi

while true; do
    show_banner

    echo "1) Create VPS"
    echo "2) List VPS"
    echo "3) Open VPS"
    echo "4) Stop VPS"
    echo "5) Delete VPS"
    echo "6) Exit"
    echo

    read -r -p "Choice: " c

    case "$c" in
        1)
            echo
            echo "1) Ubuntu 24.04"
            echo "2) Debian 12"

            read -r -p "OS: " o

            case "$o" in
                1) BASE_IMAGE="ubuntu:24.04" ;;
                2) BASE_IMAGE="debian:12" ;;
                *)
                    echo "Invalid OS selection."
                    sleep 1
                    continue
                    ;;
            esac

            if ! docker image inspect "$BASE_IMAGE" >/dev/null 2>&1; then
                echo "Downloading base image: $BASE_IMAGE"
                docker pull "$BASE_IMAGE"
            fi

            build_image "$BASE_IMAGE"

            NAME="bb-vps-$(date +%s)-${RANDOM}"

            docker create -it \
                --label "${LABEL}=true" \
                --name "$NAME" \
                --hostname "$HOSTNAME_SET" \
                --restart unless-stopped \
                "$BUILT_IMAGE" bash >/dev/null

            echo
            echo "VPS created: $NAME"
            echo "OS: $BASE_IMAGE"
            echo "Hostname: $HOSTNAME_SET"
            echo
            echo "Opening VPS terminal..."

            docker start -ai "$NAME" || true
            pause
            ;;

        2)
            docker ps -a \
                --filter "label=${LABEL}=true" \
                --format "Name: {{.Names}} | Status: {{.Status}}"
            pause
            ;;

        3)
            if select_container; then
                if [ "$(docker inspect -f '{{.State.Running}}' "$SEL")" = "true" ]; then
                    docker exec -it "$SEL" bash
                else
                    docker start -ai "$SEL" || true
                fi
            fi
            pause
            ;;

        4)
            if select_container; then
                docker stop "$SEL"
            fi
            pause
            ;;

        5)
            if select_container; then
                read -r -p "Delete $SEL permanently? (yes/no): " confirm
                if [ "$confirm" = "yes" ]; then
                    docker rm -f "$SEL"
                    echo "VPS deleted."
                else
                    echo "Cancelled."
                fi
            fi
            pause
            ;;

        6)
            exit 0
            ;;

        *)
            echo "Invalid choice."
            sleep 1
            ;;
    esac
done
