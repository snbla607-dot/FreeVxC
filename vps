
#!/usr/bin/env bash
set -euo pipefail

GREEN="\e[1;32m"
RED="\e[1;31m"
CYAN="\e[1;36m"
YELLOW="\e[1;33m"
MAGENTA="\e[1;35m"
WHITE="\e[1;37m"
GRAY="\e[1;90m"
RESET="\e[0m"

HOSTNAME_SET="billubadmosh"
IMAGE="billubadmosh-vps"
LABEL="billubadmosh-vps"
BUILD_DIR="/tmp/billubadmosh-vps"

cleanup() {
    tput cnorm 2>/dev/null || true
}
trap cleanup EXIT INT TERM

show_banner() {
    clear
    echo -e "${MAGENTA}"
    cat <<'EOF'

  ____  _ _ _       _   _ ____   _   _    _    ____  __  __  ___  ____  _   _
 | __ )(_) | |_   _| | | | __ ) | | | |  / \  |  _ \|  \/  |/ _ \|  _ \| | | |
 |  _ \| | | | | | | | | |  _ \ | |_| | / _ \ | | | | |\/| | | | | |_) | |_| |
 | |_) | | | | |_| | |_| | |_) ||  _  |/ ___ \| |_| | |  | | |_| |  __/|  _  |
 |____/|_|_|_|\__, |\___/|____/ |_| |_/_/   \_\____/|_|  |_|\___/|_|   |_| |_|
           

EOF
    echo -e "${CYAN}       =============================================${RESET}"
    echo -e "${WHITE}                  B I L L U B A D M O S H${RESET}"
    echo -e "${YELLOW}                    V P S   M A N A G E R${RESET}"
    echo -e "${CYAN}       =============================================${RESET}"
    echo -e "${GRAY}                Your Terminal. Your VPS.${RESET}"
    echo
}

type_line() {
    local message="$1"
    local color="$2"

    printf "%b" "$color"
    for ((i=0; i<${#message}; i++)); do
        printf "%s" "${message:$i:1}"
        sleep 0.008
    done
    printf "%b\n" "$RESET"
}

progress() {
    local label="$1"
    local steps=35
    local percent filled empty

    for ((i=0; i<=steps; i++)); do
        percent=$((i * 100 / steps))
        filled=$((percent / 2))
        empty=$((50 - filled))

        printf "\r%b%-37s%b [" "$CYAN" "$label" "$RESET"

        for ((j=0; j<filled; j++)); do
            printf "%b█%b" "$GREEN" "$RESET"
        done

        printf "%*s" "$empty" ""
        printf "] %3d%%" "$percent"
        sleep 0.025
    done
    printf "\n"
}

startup() {
    clear
    tput civis 2>/dev/null || true
    show_banner

    type_line "[*] Initializing BilluBadmosh..." "$WHITE"
    type_line "[*] Loading VPS manager..." "$WHITE"
    type_line "[*] Checking Docker environment..." "$WHITE"
    echo

    progress "[01/05] Loading configuration"
    progress "[02/05] Preparing interface"
    progress "[03/05] Checking runtime"
    progress "[04/05] Loading container tools"
    progress "[05/05] Finalizing startup"

    echo
    echo -e "${GREEN}[✓] BilluBadmosh interface ready${RESET}"
    echo -e "${GREEN}[✓] VPS management enabled${RESET}"
    echo

    sleep 0.5
    tput cnorm 2>/dev/null || true
}

pause() {
    read -r -p "Press Enter to continue..." _ || true
}

select_container() {
    local idx

    mapfile -t CONTAINERS < <(
        docker ps -a \
            --filter "label=${LABEL}=true" \
            --format "{{.Names}}"
    )

    if [ "${#CONTAINERS[@]}" -eq 0 ]; then
        echo -e "${YELLOW}No BilluBadmosh VPS containers found.${RESET}"
        return 1
    fi

    echo
    for i in "${!CONTAINERS[@]}"; do
        printf "%s) %s\n" "$((i+1))" "${CONTAINERS[$i]}"
    done

    read -r -p "Select VPS: " idx || return 1

    if [[ ! "$idx" =~ ^[0-9]+$ ]] ||
       (( idx < 1 || idx > ${#CONTAINERS[@]} )); then
        echo -e "${RED}Invalid selection.${RESET}"
        return 1
    fi

    SEL="${CONTAINERS[$((idx-1))]}"
}

build_image() {
    local base_image="$1"
    local image_tag="${IMAGE}:${base_image//[:\/]/-}"

    mkdir -p "$BUILD_DIR"
    cd "$BUILD_DIR"

    cat > Dockerfile <<EOF
FROM ${base_image}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl wget nano sudo bash git unzip zip tar vim \
    htop screen tmux net-tools iproute2 procps python3 python3-pip \
    nodejs npm \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /root
CMD ["bash"]
EOF

    if ! docker image inspect "$image_tag" >/dev/null 2>&1; then
        echo -e "${CYAN}Building image: ${image_tag}${RESET}"
        docker build -t "$image_tag" .
    fi

    BUILT_IMAGE="$image_tag"
}

create_vps() {
    local base_image name os_choice

    echo
    echo "1) Ubuntu 24.04"
    echo "2) Debian 12"

    read -r -p "Select operating system: " os_choice || return

    case "$os_choice" in
        1) base_image="ubuntu:24.04" ;;
        2) base_image="debian:12" ;;
        *)
            echo -e "${RED}Invalid OS selection.${RESET}"
            pause
            return
            ;;
    esac

    if ! docker image inspect "$base_image" >/dev/null 2>&1; then
        echo -e "${CYAN}Downloading ${base_image}...${RESET}"
        docker pull "$base_image"
    fi

    build_image "$base_image"

    name="bb-vps-$(date +%s)-${RANDOM}"

    docker create -it \
        --label "${LABEL}=true" \
        --name "$name" \
        --hostname "$HOSTNAME_SET" \
        "$BUILT_IMAGE" bash >/dev/null

    echo
    echo -e "${GREEN}[✓] VPS created successfully${RESET}"
    echo -e "${WHITE}Name: $name${RESET}"
    echo -e "${WHITE}OS: $base_image${RESET}"
    echo -e "${WHITE}Hostname: $HOSTNAME_SET${RESET}"
    echo

    docker start -ai "$name" || true
    pause
}

list_vps() {
    echo
    docker ps -a \
        --filter "label=${LABEL}=true" \
        --format "table {{.Names}}\t{{.Status}}\t{{.Image}}"
    pause
}

open_vps() {
    if select_container; then
        local running
        running=$(docker inspect -f '{{.State.Running}}' "$SEL")

        if [ "$running" = "true" ]; then
            docker exec -it "$SEL" bash || true
        else
            echo -e "${YELLOW}Starting ${SEL}...${RESET}"
            docker start "$SEL" >/dev/null
            docker exec -it "$SEL" bash || true
        fi
    fi
    pause
}

stop_vps() {
    if select_container; then
        if [ "$(docker inspect -f '{{.State.Running}}' "$SEL")" = "true" ]; then
            docker stop "$SEL"
            echo -e "${GREEN}VPS stopped.${RESET}"
        else
            echo -e "${YELLOW}VPS is already stopped.${RESET}"
        fi
    fi
    pause
}

delete_vps() {
    if select_container; then
        local confirm
        read -r -p "Permanently delete ${SEL}? (yes/no): " confirm || return

        if [ "$confirm" = "yes" ]; then
            docker rm -f "$SEL"
            echo -e "${GREEN}VPS deleted.${RESET}"
        else
            echo "Cancelled."
        fi
    fi
    pause
}

main() {
    if ! command -v docker >/dev/null 2>&1; then
        echo -e "${RED}Error: Docker is not installed.${RESET}"
        exit 1
    fi

    if ! docker info >/dev/null 2>&1; then
        echo -e "${RED}Error: Docker daemon is unavailable or permission denied.${RESET}"
        exit 1
    fi

    startup

    while true; do
        show_banner

        echo -e "${GREEN} [1]${RESET} Create VPS"
        echo -e "${GREEN} [2]${RESET} List VPS"
        echo -e "${GREEN} [3]${RESET} Open VPS"
        echo -e "${GREEN} [4]${RESET} Stop VPS"
        echo -e "${GREEN} [5]${RESET} Delete VPS"
        echo -e "${RED} [6]${RESET} Exit"
        echo

        read -r -p "BilluBadmosh > " choice || break

        case "$choice" in
            1) create_vps ;;
            2) list_vps ;;
            3) open_vps ;;
            4) stop_vps ;;
            5) delete_vps ;;
            6) echo -e "${MAGENTA}Goodbye from BilluBadmosh!${RESET}"; exit 0 ;;
            *) echo -e "${RED}Invalid choice.${RESET}"; sleep 1 ;;
        esac
    done
}

main
